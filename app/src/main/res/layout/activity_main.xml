<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="35dp"
    android:layout_marginBottom="40dp">

    <!-- HARİTA (MAPVIEW) - en altta, tüm yükseklik -->
    <org.mapsforge.map.android.view.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ROTA DETAYLARI KUTUSU - ekranın altına sabitlendi, butonların üzerinde -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRouteInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="90dp"
        android:elevation="4dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rota Detayları"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tvRouteInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lütfen bir hedef seçin"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SOL ALTTAKİ BUTONLAR -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLocate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konum"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnEnkaz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2196F3"
            android:text="Düdük"
            android:textColor="#FFFFFF"
            android:drawableStart="@android:drawable/ic_btn_speak_now" />
    </LinearLayout>

    <!-- SAĞ ALTTAKİ MENÜ BUTONU -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#FF9800"
        android:src="@android:drawable/ic_menu_search"
        android:elevation="8dp"
        app:tint="#FFFFFF" />

    <!-- ACİL DURUM BUTONU -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAcil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="30dp"
        android:layout_toStartOf="@id/btnMenu"
        android:backgroundTint="#F44336"
        android:elevation="8dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="#FFFFFF" />

    <!-- AÇILIR MENÜ: Polis - cardRouteInfo'nun üzerinde görünmesi için yüksek elevation -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnPolice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnHospital"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="Polis Bul"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1976D2"
        android:elevation="12dp"
        app:icon="@android:drawable/ic_dialog_map"
        app:iconTint="#FFFFFF"
        android:visibility="gone" />

    <!-- AÇILIR MENÜ: Hastane -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnHospital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnMenu"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="Hastane"
        android:elevation="12dp"
        android:visibility="gone"
        app:icon="@android:drawable/ic_menu_add" />

</RelativeLayout>